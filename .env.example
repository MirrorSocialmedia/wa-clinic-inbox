# WA Clinic Inbox — environment template
# Copy to .env and fill in. NEVER commit .env.

# --- Database (PostgreSQL 16, 獨立 DB wa_inbox / 獨立 role) ---
DATABASE_URL=postgresql://wa_inbox:***@localhost:5432/wa_inbox

# --- Redis 7 (BullMQ queue + healthz) ---
# ★ production 必須帶密碼（requirepass）+ bind 127.0.0.1（AppSec 審計 AS-1）：
#   queue job payload 含病人訊息原文（RDB/AOF 會明文落碟），共用 VPS 上無認證 Redis
#   = 同機任何 process 可讀病人原文 / 注入偽造 job。本地 dev 可唔帶密碼。
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:6379

# --- Meta WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=  # test number 先用
# Mock mode：1 = 唔打真 API（graph 回假 wamid / inbound 跳過媒體下載）— 無 token 時本地開發/E2E 用
WA_MOCK=1

# --- Meta App Review：Embedded Signup + Template 監察（2026-08-20 新增）---
# FB App（Business 型，已加 WhatsApp product）— FB Dashboard → App Settings → Basic。
# NEXT_PUBLIC_* 會 inline 入 client bundle — 係公開值（App ID 唔係 secret），但 app secret 唔好用 NEXT_PUBLIC_。
NEXT_PUBLIC_FB_APP_ID=
# Embedded Signup 嘅 config_id — FB Dashboard → Embedded Signup 建完先有（App Review MD §2.1）。
NEXT_PUBLIC_FB_CONFIG_ID=
# WABA id — FB Dashboard → WhatsApp → API Setup（Template 監察頁用；production 到 onboarding 時逐店有真值）。
WA_WABA_ID=
# （可選）phone number two-step PIN — exchange route 預設來源（onboarding UI 可以 body.pin 覆蓋）。
# ★ PIN 記入 runbook，唔入 DB、唔入 log。
# WA_ES_PIN=
# 媒體下載目錄（dev 不可寫會 fallback /tmp/wa-media + 響亮 warning；★ production 不可寫 = throw fail-fast，唔准 fallback）
WA_MEDIA_DIR=/srv/wa-media
# ★ 媒體 at-rest 加密 key（安全審計 C-1b）：per-file AES-256-GCM（32 bytes hex，openssl rand -hex 32）
#   production 冇 key = 媒體落唔到碟（throw）；dev 冇 key = 明文 + 響亮 warning（e2e sandbox 預設唔設）
#   洩漏要換 key + 舊檔重加密（舊明文檔會照 serve 做 legacy，新檔全部密文）
# MEDIA_ENC_KEY=
# ★ 碟級 at-rest 加密確認旗（安全審計 C-1）：/var/lib/postgresql + /srv/wa-media 開咗 LUKS/雲碟加密先設 1
#   未設 → production boot/healthz log ERROR（「未加密碟」冇得靜默）
# DISK_ENCRYPTED=1

# --- Local AI (vLLM / sglang，Tailscale 私網或本機) — Phase 2 ---
# OpenAI-compatible endpoint。兩類部署：
#   • vLLM（GPU 機，Tailscale IP）：
#     例：vllm serve Qwen/Qwen2.5-32B-Instruct-AWQ --tensor-parallel-size 2 --max-model-len 8192 \
#         --gpu-memory-utilization 0.92 --host <tailscale IP> --port 8000
#   • sglang（本機）：http://127.0.0.1:30000/v1（model id 可含 `/`，照字面傳）
# model id 含 `/` 冇問題 — OpenAI-compatible API 入面 model 只係 request body 字串。
VLLM_BASE_URL=http://100.x.y.z:8000/v1   # 或 http://127.0.0.1:30000/v1（sglang）
VLLM_API_KEY=          # 可選（vLLM / 本地 sglang 預設唔使 key）
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ   # sglang 例：/models/Qwen3.8-27B-FP8
VLLM_FALLBACK_MODEL=   # 空 = 只用 primary（sglang 本地通常只有一個 model）
AI_TIMEOUT_MS=8000     # 單次 call 超時（每 model 重試 1 次 → fallback）
AI_DISABLE_THINKING=1  # 1（預設）= 送 chat_template_kwargs.enable_thinking=false（Qwen3.x thinking model 必需；非 thinking model 會忽略）
AI_MOCK=1              # 1 = deterministic mock（無 GPU 本地開發/E2E 用；上線改 0）
AI_MOCK_FAIL=          # 1 = mock 模擬 AI 斷線（只限 mock mode；測降級路徑）
AI_BASE_URL=           # 兼容 fallback（VLLM_BASE_URL 未設時用）

# --- Crypto / session ---
# 注意：DB 文字欄（Message.body 等）冇應用層加密 — at-rest 加密 = 部署層 LUKS/雲碟加密（見 deploy 文件）。
# 所以 SESSION_SECRET / TOTP_ENC_KEY 一旦洩漏，舊 cookie/密文都可以被解 — 洩漏要換 key + 強制全人重登。
SESSION_SECRET=  # iron-session, >= 32 chars random
# ★ TOTP secret 加密 key（安全審計 H-2）：32 bytes base64（openssl rand -base64 32）
#   加密 StaffUser.totpSecretEnc（AES-256-GCM）。獨立 key — 任邊把 key 洩漏唔會牽連另一邊。洩漏：換 key + 全部 admin 重新 enroll（舊密文解唔到 = fail-closed）。
#   production 冇設/格式壞 → TOTP enroll 500 + 已啟用 admin 登入 500（唔會靜默放行 MFA）。
# TOTP_ENC_KEY=

# --- Workforce External API（Phase 3：空檔來源 — 2026-08-23 由 Apricot 直連切換）---
# clinic-workforce /api/external/v1/availability base URL（部署 checklist 填真值）
WORKFORCE_API_URL=
# x-api-key header（scope: availability — workforce 邊 /external-api 頁生成；★ 永不入 log）
WORKFORCE_API_KEY=
# 1 = 決定性 mock（零 HTTP — fixture grid；E2E/開發用；上線改 0）
WORKFORCE_MOCK=1
# ★ 病人電話索引用（booking-ui patient-lookup）：wa-inbox 用呢把 HMAC-SHA256 key 算 phoneHash 先傳 workforce。
#   必需（patient-context 功能開機必需）+ 必須同 clinic-workforce 嘅 PHONE_HASH_KEY 值完全相同 —
#   唔同 → 搜尋永遠零 match（靜默，唔會報錯）。32+ bytes random（openssl rand -base64 32）；洩漏要兩邊同步換。
PHONE_HASH_KEY=

# --- WhatsApp Flow（Phase 3：預約收集）---
# flow_token JWT secret（>= 32 bytes random; openssl rand -hex 32）
FLOW_JWT_SECRET=
# RSA-2048 keypair 持久化目錄（首次 boot 生成；.gitignore 已排）
# ★ M-6（安全審計）：production 必須設 /etc/wa-inbox/flow-keys — 私匙唔好放 repo working dir 內
#   （rsync/backup/誤 commit 會跟 repo snapshot 一齊走）。.dev/flow-keys 只係 dev 預設；
#   production boot 會检查 resolve 後路徑，喺 repo 內 → log 醒目 WARN（src/lib/boot-key-paths.ts）。
# FLOW_KEYS_DIR=/etc/wa-inbox/flow-keys
FLOW_KEYS_DIR=.dev/flow-keys
# （可選）純收需求變體 canvas（資料源離線時：DatePicker + 上晝/下晝/夜晚 RadioButtons，唔列時段）—
# WhatsApp Manager publish 之後填。未設 → 發卡時 fallback 正常 canvas（endpoint 嘅 NONE 分支仍會出 REQUIREMENT screen data）。
# FLOW_REQ_CDN_URL=
# FLOW_REQ_ID=

# --- Phase 4：監控 + 警報（health cron / quality / weekly report） ---
# 警報通知渠道：log（預設，只入 log，sandbox 用）/ telegram / whatsapp
ALERT_CHANNEL=log
# telegram channel：二揀一
#   • 內部 relay webhook（POST { text }）
TELEGRAM_ALERT_WEBHOOK_URL=
#   • 標準 Bot API（兩項都要）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# whatsapp channel：發去你自己個號（真 mode 先有真發；WA_MOCK=1 時只 log 唔真發）
WA_ALERT_TO=

# --- Phase 4：duty-roster 消費端（workforce 邊提供） ---
# mock mode：1 = 回固定 fixture 3 人（sandbox 預設；★ 上線必須設 0 — 未設 / 空值都會 fallback 回 1，即返 mock 名單）
DUTY_MOCK=1
# 真 mode：經 workforce client（WORKFORCE_API_URL / WORKFORCE_API_KEY — 同一對憑證，v1 duty-roster endpoint）

# --- Phase 4：backup（scripts/backup-wa.sh / restore-wa-test.sh） ---
# backup 落盤目錄（預設 .dev/backups，gitignored）
BACKUP_DIR=.dev/backups
# 保留日數（預設 30）
BACKUP_RETENTION_DAYS=30
# age keypair 文件（gitignored；首次 backup 且有 age 時自動生成，丟咗就解唔到！）
# ★ M-6：production 必須設 /etc/wa-inbox/age.key（同上 — 私匙唔好放 repo 內）
# AGE_KEY_FILE=/etc/wa-inbox/age.key
AGE_KEY_FILE=.dev/age.key

# --- AI Workflow T1（cwi-ai-20260824-t1）：P0 retention purge（每日 04:00 HK cron）---
# privacy 頁承諾嘅自動刪除保留期 — env 化（老細未最終簽，簽完改 env 唔使改 code）。
# 壞值（非正整數）會 fallback 預設值（24/12/90）— 唔會令 purge 死咗。
RETENTION_CONV_MONTHS=24   # 對話訊息（連 NoteReadReceipt + PatientFact）
RETENTION_MEDIA_MONTHS=12  # 媒體檔（刪碟上加密檔 + mediaPath=null；訊息殼留到對話期）
RETENTION_DRAFT_DAYS=90    # AiDraft（只刪 status ≠ PROPOSED；PROPOSED 留俾 staff 審批）
# 註：StaffNotice 已讀保留 90 日係 spec 固定值（§6.0），未設獨立 env。
# --- AI Workflow Phase A：AUTO 真人冷靜期（可選第八閘 human-recent）---
# 員工人手覆完後 AI 幾長時間唔搶咪（ms；預設 1800000 = 30 分鐘）
AI_HUMAN_COOLDOWN_MS=1800000

# --- Server ---
PORT=3100
LOG_LEVEL=info
