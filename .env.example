# WA Clinic Inbox — environment template
# Copy to .env and fill in. NEVER commit .env.

# --- Database (PostgreSQL 16, 獨立 DB wa_inbox / 獨立 role) ---
DATABASE_URL=postgresql://wa_inbox:***@localhost:5432/wa_inbox

# --- Redis 7 (BullMQ queue + healthz) ---
REDIS_URL=redis://localhost:6379

# --- Meta WhatsApp Cloud API ---
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=  # test number 先用
# Mock mode：1 = 唔打真 API（graph 回假 wamid / inbound 跳過媒體下載）— 無 token 時本地開發/E2E 用
WA_MOCK=1
# 媒體下載目錄（冇權限會 fallback /tmp/wa-media）
WA_MEDIA_DIR=/srv/wa-media

# --- Local AI (vLLM / sglang，Tailscale 私網或本機) — Phase 2 ---
# OpenAI-compatible endpoint。兩類部署：
#   • vLLM（GPU 機，Tailscale IP）：
#     例：vllm serve Qwen/Qwen2.5-32B-Instruct-AWQ --tensor-parallel-size 2 --max-model-len 8192 \
#         --gpu-memory-utilization 0.92 --host <tailscale IP> --port 8000
#   • sglang（本機）：http://127.0.0.1:30000/v1（model id 可含 `/`，照字面傳）
# model id 含 `/` 冇問題 — OpenAI-compatible API 入面 model 只係 request body 字串。
VLLM_BASE_URL=http://100.x.y.z:8000/v1   # 或 http://127.0.0.1:30000/v1（sglang）
VLLM_API_KEY=          # 可選（vLLM / 本地 sglang 預設唔使 key）
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ   # sglang 例：/models/Qwen3.8-27B-FP8
VLLM_FALLBACK_MODEL=   # 空 = 只用 primary（sglang 本地通常只有一個 model）
AI_TIMEOUT_MS=8000     # 單次 call 超時（每 model 重試 1 次 → fallback）
AI_DISABLE_THINKING=1  # 1（預設）= 送 chat_template_kwargs.enable_thinking=false（Qwen3.x thinking model 必需；非 thinking model 會忽略）
AI_MOCK=1              # 1 = deterministic mock（無 GPU 本地開發/E2E 用；上線改 0）
AI_MOCK_FAIL=          # 1 = mock 模擬 AI 斷線（只限 mock mode；測降級路徑）
AI_BASE_URL=           # 兼容 fallback（VLLM_BASE_URL 未設時用）

# --- Crypto / session ---
TOKEN_ENC_KEY=  # 32 bytes base64 (openssl rand -base64 32) — 加密 ApricotSession 三件套
SESSION_SECRET=  # iron-session, >= 32 chars random

# --- Server ---
PORT=3100
LOG_LEVEL=info
