// WA Clinic Inbox — 資料模型（照框架 MD §4 全文）
// 注意：本地無 DB — 只 `prisma validate` / `prisma generate`，唔跑 migrate dev。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum Direction {
  IN
  OUT
}

enum Channel {
  API        // 系統發
  APP_ECHO   // 店員手機 App 發嘅回音
  HISTORY    // 舊 chat 匯入
}

enum ConvStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MsgStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum DraftStatus {
  PROPOSED
  SENT_AS_IS
  SENT_EDITED
  // Phase 2b：AUTO 模式 AI 直接發出（staff 之後可審計；sentByStaffId=null + aiAutoSent=true）
  SENT_AUTO
  DISCARDED
}

// Phase 2b：逐舖 AI 模式（指揮大神 2026-08-18 決定，覆蓋 MD D5「AI 永不發送」）
// DRAFT = 預設：AI 只出建議，staff 採用先發；AUTO = AI 回覆直接自動發出
// （URGENT_PAIN / HIGH / needsHuman / 過 24h 窗口 永遠例外 — 退回 DRAFT 行為）
enum AiMode {
  DRAFT
  AUTO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

model Clinic {
  id               String  @id @default(cuid())
  code             String  @unique            // TKW / MF ...（同 clinic-workforce 用同一套 code，方便對照）
  name             String
  waPhoneNumberId  String  @unique            // Meta phone_number_id — 分流嘅 key
  waDisplayNumber  String
  apricotClinicId  String?                    // 對照 provider-roster 已有實值
  greetingConfig   Json?                      // 營業時間/地址/常見 FAQ，餵畀 AI 草稿用
  // Phase 2b：逐舖 AI 模式（default DRAFT = 舊行為；AUTO = AI 可直接自動發）
  aiMode           AiMode  @default(DRAFT)
  // Phase 3：該店醫生名錄（SCREEN_PROVIDER 來源；sync 表 — 多對多，醫生可以跨店）
  providers        ProviderClinic[]
  // Phase 4：webhook 最後事件時間（inbound worker 每 event 更新）— 5 分鐘健康自檢
  // stale 判斷用：有 traffic（!= null）但 > 30 分鐘無事件 → 警報；null = 從來無 traffic 唔計。
  lastWebhookEventAt DateTime? @db.Timestamptz
  // Phase 4：quality_rating 每日檢查結果（GREEN/YELLOW/RED）+ 上次檢查時間（/admin 顯示）
  qualityRating    String?                    // GREEN / YELLOW / RED
  qualityCheckedAt DateTime? @db.Timestamptz
}

model StaffUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  clinicId     String?                        // STAFF 必填；ADMIN 留空 = 跨店
  active       Boolean @default(true)
}

model Contact {
  id          String @id @default(cuid())
  clinicId    String
  waId        String                          // 852XXXXXXXX
  profileName String?
  labels      String[]
  @@unique([clinicId, waId])                  // 同一病人喺兩間店 = 兩條 Contact（隔離）
}

model Conversation {
  id               String     @id @default(cuid())
  clinicId         String
  contactId        String
  status           ConvStatus @default(OPEN)
  assigneeId       String?
  intent           String?                    // 最近一次分類結果
  intentConfidence Float?
  // Phase 2（AI triage）：
  // - urgency/aiSummary 同 intent 一齊落 Conversation（唔係 Message）：
  //   UI 隊列欄/側欄要喺對話層顯示，且語義係「呢個對話而家嘅狀態」，
  //   跟緊 Phase 1 已建嘅 intent 欄慣例，避免加新表多一層 join。
  // - urgent 鐵律旗：urgency=HIGH 或 intent=URGENT_PAIN 時由 AI worker 置 true；
  //   對話轉 RESOLVED 或 staff 手動清；置 true 後唔會自動清（避免新訊息蓋過未處理急症）。
  urgency          String?                    // LOW / MED / HIGH（最近一次分類）
  urgent           Boolean  @default(false)
  aiSummary        String?                    // ≤50 字摘要（側欄顯示；語言跟病人）
  lastInboundAt    DateTime? @db.Timestamptz                  // ★ 24h 窗口由呢個欄計
  lastMessageAt    DateTime @db.Timestamptz
  unreadCount      Int        @default(0)

  @@unique([clinicId, contactId])
  @@index([clinicId, status, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  // Phase 1 改動：waMessageId 由 NOT NULL 變 nullable。
  // 原因：outbound 發送鏈係「先寫 Message(OUT,API,QUEUED) 先入 queue」，
  // Graph API 回傳 wamid 之後先 UPDATE 入呢欄（MD §6.3）。NOT NULL 會令
  // QUEUED row 寫唔到。Postgres unique index 允許多 NULL，冪等語義唔變
  // （inbound/status 永遠有 wamid，webhook 冪等仍然成立）。
  waMessageId    String?   @unique            // ★ 冪等 key（webhook 會重發）
  direction      Direction
  channel        Channel
  type           String                       // text/image/audio/document/interactive/nfm_reply...
  body           String?                      // 文字內容（at-rest 加密 = 部署層 LUKS/雲碟加密，見 deploy 文件；log 絕不出現）
  mediaPath      String?                      // 落地 /srv/wa-media/<id>，唔存 Meta URL（會過期）
  status         MsgStatus
  errorCode      String?
  sentByStaffId  String?
  aiDraftId      String?
  // Phase 2b：AI 自動發送標記（AUTO 模式）。設計決策：唔加獨立 `source` enum —
  // 現有 channel(API/APP_ECHO/HISTORY) + sentByStaffId(null) + aiDraftId 已足夠
  // 識別「系統 AI 自動發」；再加 source 會同 channel 雙重事實來源（drift 風險）。
  // AUTO 訊息 = direction=OUT + channel=API + sentByStaffId=null + aiAutoSent=true。
  aiAutoSent     Boolean  @default(false)
  waTimestamp    DateTime @db.Timestamptz
  createdAt      DateTime @db.Timestamptz  @default(now())
  @@index([conversationId, waTimestamp])
}

model AiDraft {
  id                 String      @id @default(cuid())
  conversationId     String
  inReplyToMessageId String
  draftText          String
  model              String
  latencyMs          Int
  status             DraftStatus @default(PROPOSED)
  finalText          String?                  // 員工改完實際發出嘅版本 → 攞嚟計採用率+做微調數據
  createdAt          DateTime @db.Timestamptz    @default(now())
  // Phase 2 冪等：同一條 inbound Message 只可有一條 draft。
  // AI job 重試（attempts 3）或部分失敗重跑時，唯一約束 + findUnique 前置檢查
  // 保證唔會生成重複 draft。一條訊息只觸發一次 AI 分類，語義上多 draft 無意義。
  @@unique([conversationId, inReplyToMessageId])
}

// Phase 2：AI call 統計（singleton row id=1）— admin AI 狀態卡「最近 call 成功率」數據源。
// 由 AI worker 每次 call 後 atomic upsert；web process（admin 頁/API）讀。
// 唔存任何 prompt/response 內容 — 只係計數 + 時間 + 錯訊短句（metadata only）。
model AiCallStats {
  id         Int       @id @default(1)
  totalCalls Int       @default(0)
  okCalls    Int       @default(0)
  lastOkAt   DateTime? @db.Timestamptz
  lastError  String?
  // Phase 2b：最近一次成功 call 嘅 latency/tokens（admin AI 狀態卡實測數據；metadata only）
  lastLatencyMs Int?
  lastTokens    Int?
  updatedAt  DateTime  @db.Timestamptz @default(now()) @updatedAt
}

model BookingRequest {
  id                String        @id @default(cuid())
  conversationId    String
  clinicId          String
  flowToken         String        @unique     // 發 Flow 時生成，nfm_reply 對返
  providerApricotId String
  providerName      String                    // 快照，唔 join
  requestedDate     String                    // YYYY-MM-DD（跟 Apricot 用 HK 日界）
  requestedTime     String                    // HH:mm
  precheckPassed    Boolean                   // 發卡嗰刻對照空檔 cache 嘅結果
  status            BookingStatus @default(PENDING)
  handledByStaffId  String?
  handledAt         DateTime? @db.Timestamptz
  createdAt         DateTime @db.Timestamptz      @default(now())
  // Phase 3：/bookings 隊列查詢（本店 + 狀態 + 時間）
  @@index([clinicId, status, createdAt])
}

// Phase 3：醫生名錄（sync 表）— SCREEN_PROVIDER 嘅數據源。
// 名錄由 seed（mock 期：由 greetingConfig.doctors 派生決定性 apricotId）或
// Apricot 醫生 sync（real 期，APRICOT_DOCTORS_PATH 設定時）維護。
// ★ PII：只存醫生名 + Apricot ext id — 零病人資料。
model Provider {
  id        String   @id @default(cuid())
  name      String                    // 醫生名（顯示用）
  apricotId String?  @unique          // Apricot practitioner ext id（mock = mock-pract-<clinic>-<n>）
  active    Boolean  @default(true)
  createdAt DateTime @db.Timestamptz @default(now())
  clinics   ProviderClinic[]
}

model ProviderClinic {
  providerId String
  clinicId   String
  createdAt  DateTime @db.Timestamptz @default(now())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@id([providerId, clinicId])
}

// Phase 3：發出咗嘅 WhatsApp Flow 狀態（📅 掣冪等 / 48h 棄單 / nfm_reply 對 token 用）。
// status: SENT（流緊）/ COMPLETED（病人撳 Complete）/ FAILED（precheck 失敗，已重出）/ ABANDONED（48h 棄單）
// ★ 只存 token + 關聯 id — 零病人選擇內容（選擇喺 BookingRequest）。
model FlowSession {
  id               String    @id @default(cuid())
  conversationId   String
  clinicId         String
  flowToken        String    @unique        // 簽咗 conversationId+clinicId 嘅 JWT
  flowMessageWamid String?                   // 發出嘅 interactive flow 訊息 wamid（metadata）
  status           String    @default("SENT")
  createdAt        DateTime  @db.Timestamptz @default(now())
  completedAt      DateTime? @db.Timestamptz
  @@index([conversationId, status])
  @@index([status, createdAt])
}

model AvailabilitySlot {                       // Apricot 讀返嚟嘅空檔 cache — ★ 只存時段佔用，零病人資料
  id                String   @id @default(cuid())
  clinicId          String
  providerApricotId String
  date              String
  startTime         String
  endTime           String
  bookedCount       Int
  isOpen            Boolean                    // practitionerOpenSchs 開診 = true
  syncedAt          DateTime @db.Timestamptz
  @@unique([clinicId, providerApricotId, date, startTime])
}

model ApricotSession {                         // 三件套（加密存），機制照搬 provider-roster
  id              Int      @id @default(1)
  accessTokenEnc  String
  refreshTokenEnc String
  iatEnc          String
  updatedAt       DateTime @db.Timestamptz @updatedAt
  // Phase 3：監控 metadata（/api/admin/apricot-status 用；零 token 原文）
  lastSyncAt      DateTime? @db.Timestamptz   // 最近一次空檔 sync 成功（heartbeat）
  lastKeepaliveAt DateTime? @db.Timestamptz   // 最近一次 keepalive 輕量 request
  lastError       String?                     // 最近一次失敗（metadata 短句）
  rotationCount   Int      @default(0)        // Set-Cookie rotation 累計次數
}

model WebhookEvent {                           // 冪等 + 除錯（★ 唔存 payload 原文，只存 metadata）
  id          String   @id                     // wamid / event id
  field       String
  receivedAt  DateTime @db.Timestamptz @default(now())
  processedAt DateTime? @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?                              // AI 自動發送 = null（無 staff 參與）
  action    String                             // SEND / AI_AUTO_SEND / CONFIRM_BOOKING / LOGIN / EXPORT ...
  entity    String?
  entityId  String?
  // Phase 2b：附加 metadata（metadata only — 永不存訊息原文 PII）。
  // AI_AUTO_SEND 用：{ conversationId, draftId, intent, urgency }
  meta      Json?
  createdAt DateTime @db.Timestamptz @default(now())
}

// Phase 4：健康自檢 / 監控警報（MD §9.3）。
// - 由 cron `health-check`（5 分鐘）/ `quality-check`（每日）產生；異常行 + 通知（ALERT_CHANNEL）。
// - 冪等：同 (type, clinicId) 未解決（resolvedAt IS NULL）只可有一條 —
//   cron 每 5 分鐘重跑唔會重覆彈警報；狀況恢復後由下一次 check 自動 set resolvedAt。
// - ★ detail 只准 metadata（queue 名/計數/分鐘數/rating/disk %）— 永不存訊息原文（iron rule 1）。
// - clinicId：per-clinic 警報（webhook_stale / quality_rating）帶店；系統級（queue_depth /
//   ai_breaker_open / apricot_sync_stale / disk_low）= null。
model Alert {
  id         String    @id @default(cuid())
  type       String    // webhook_stale | queue_depth | ai_breaker_open | apricot_sync_stale | disk_low | quality_rating
  severity   String    // MEDIUM | HIGH
  clinicId   String?
  clinicCode String?   // 快照（顯示用；唔 join — 店被刪都睇到）
  detail     Json?     // metadata only
  createdAt  DateTime  @db.Timestamptz @default(now())
  resolvedAt DateTime? @db.Timestamptz
  @@index([type, clinicId, resolvedAt])
  @@index([resolvedAt, createdAt])
}

// Phase 4：週一自動營運報表（MD §9.3：訊息量/店、FRT 中位數、草稿採用率、Flow 完成率、
// 預約卡→確認轉化率 + 中位處理時間）。
// - 每星期一 07:00 cron 對「上一週（Mon 00:00 → Sun 24:00，本地時區）」生成。
// - 一行一個 scope：clinicId=null = ALL（ADMIN 視角，metrics 內含逐店 breakdown）；
//   clinicId=店 = 該店（STAFF /admin/ops 視角）。
// - metrics/text 全部係計數/中位數/比率（metadata only）— 零病人資料。
model OpsReport {
  id          String   @id @default(cuid())
  periodStart DateTime @db.Timestamptz   // 週一 00:00（本地）
  periodEnd   DateTime @db.Timestamptz   // 下週一 00:00（exclusive）
  clinicId    String   @default("")      // "" = ALL（全部店；Postgres unique 對 NULL 唔生效 → 用 "" sentinel）
  metrics     Json
  text        String                     // 人類可讀報表（俾 ALERT_CHANNEL 推送；metadata only）
  createdAt   DateTime @db.Timestamptz @default(now())
  @@unique([periodStart, clinicId])
  @@index([periodStart])
}
