// WA Clinic Inbox — 資料模型（照框架 MD §4 全文）
// 注意：本地無 DB — 只 `prisma validate` / `prisma generate`，唔跑 migrate dev。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum Direction {
  IN
  OUT
}

enum Channel {
  API        // 系統發
  APP_ECHO   // 店員手機 App 發嘅回音
  HISTORY    // 舊 chat 匯入
  INTERNAL   // ★ H1：內部備註（staff↔staff；永不出 Graph API — 物理上唔入 outbound queue）
}

enum ConvStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MsgStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// ★ Realtime P0 (R4, cwi-rt-20260823-a1)：media 下載生命週期。
// inbound job 落 Message 時 media 訊息 = PENDING（唔阻 per-conversation 排序）；
// media worker（獨立 concurrency=3）下載完 → READY（emit media:ready）/ SKIPPED（mock/失敗降級）/ FAILED（重試 exhausted）。
// 文字訊息永遠 READY（無 media 概念），預設值保持舊行語義不變。
enum MediaStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum DraftStatus {
  PROPOSED
  SENT_AS_IS
  SENT_EDITED
  // Phase 2b：AUTO 模式 AI 直接發出（staff 之後可審計；sentByStaffId=null + aiAutoSent=true）
  SENT_AUTO
  DISCARDED
}

// AI Workflow Phase A（cwi-ai-20260824-t1）：內部通知軌（D-8/D-9）—「AI 通知俾職員」
// 同「客戶 WhatsApp 通知」兩條軌完全分開。kind 決定 UI 圖示/顏色；新 kind 先加 enum。
enum NoticeKind {
  MEDIA_RECEIVED    // 病人 send 相/檔案（Phase A2）
  URGENT_ESCALATION // 急症（socket-only 升級為持久化 — 離線員工唔漏）
  HANDOFF_REQUEST   // session 卡死 / 病人要真人（Phase C 用）
  BOOKING_AUTO      // L4：AI 已自動落單（資訊性）
  SUGGESTION_READY  // 學習迴路有新建議（Phase E 用）
  SYSTEM
}

// Phase 2b：逐舖 AI 模式（指揮大神 2026-08-18 決定，覆蓋 MD D5「AI 永不發送」）
// DRAFT = 預設：AI 只出建議，staff 採用先發；AUTO = AI 回覆直接自動發出
// （URGENT_PAIN / HIGH / needsHuman / 過 24h 窗口 永遠例外 — 退回 DRAFT 行為）
enum AiMode {
  DRAFT
  AUTO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
}

// ★ AI Workflow Phase C（cwi-sess-20260824-c1）：slot-filling 對話式預約 session 狀態。
// ACTIVE = 收集緊 slot；CONFIRMING = 等病人對確認句話 ok；COMPLETED = 齊料（出卡/AUTO_BOOK）；
// HANDOFF = 人手接手（要真人 / 急症 / 輪數超限 / 冇進展 / staff claim）；
// ABANDONED = 過期（24h TTL cron）/ 源離線改行 Flow 接力；CANCELLED = 病人取消 / staff 改用表格 Flow。
enum BookingSessionStatus {
  ACTIVE
  CONFIRMING
  COMPLETED
  HANDOFF
  ABANDONED
  CANCELLED
}

model Clinic {
  id               String  @id @default(cuid())
  code             String  @unique            // TKW / MF ...（同 clinic-workforce 用同一套 code，方便對照）
  name             String
  waPhoneNumberId  String  @unique            // Meta phone_number_id — 分流嘅 key
  // ★ Phase B（cwi-tmpl-20260824-b1）：WABA id（template 列表 API 作用域 —
  //   GET /{wabaId}/message_templates）。onboarding exchange 帶到先寫入；nullable（舊店可後補）。
  waBusinessAccountId String? 
  waDisplayNumber  String
  apricotClinicId  String?                    // 對照 provider-roster 已有實值
  greetingConfig   Json?                      // 營業時間/地址/常見 FAQ，餵畀 AI 草稿用
  // Phase 2b：逐舖 AI 模式（default DRAFT = 舊行為；AUTO = AI 可直接自動發）
  aiMode           AiMode  @default(DRAFT)
  // Phase 3：該店醫生名錄（SCREEN_PROVIDER 來源；sync 表 — 多對多，醫生可以跨店）
  providers        ProviderClinic[]
  // Phase 4：webhook 最後事件時間（inbound worker 每 event 更新）— 5 分鐘健康自檢
  // stale 判斷用：有 traffic（!= null）但 > 30 分鐘無事件 → 警報；null = 從來無 traffic 唔計。
  lastWebhookEventAt DateTime? @db.Timestamptz
  // Phase 4：quality_rating 每日檢查結果（GREEN/YELLOW/RED）+ 上次檢查時間（/admin 顯示）
  qualityRating    String?                    // GREEN / YELLOW / RED
  qualityCheckedAt DateTime? @db.Timestamptz
  // ★ H3：該店自動派單政策（app 內設定）— { mode: "MANUAL_CLAIM"|"ROUND_ROBIN"|"DUTY_ROSTER" }
  // NULL = 預設 MANUAL_CLAIM（新對話入店隊列 unassigned，員工接手/首發 auto-claim）
  assignPolicy     Json?
}

model StaffUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  clinicId     String?                        // STAFF 必填；ADMIN 留空 = 跨店
  active       Boolean @default(true)
  // 安全審計 H-2：ADMIN TOTP（RFC 6238）secret — AES-256-GCM 密文（iv|tag|ct base64，
  // 見 src/lib/totp-enc.ts，key = TOTP_ENC_KEY）。NULL = 未啟用；啟用後 ADMIN 登入
  // 第二步要 TOTP code；STAFF 永遠 NULL（登入流程完全唔變）。
  totpSecretEnc String?
  // ★ H3：自動派單 round-robin 用（「上次被派時間」最耐嗰個先；NULL = 從未派）
  lastAssignedAt DateTime? @db.Timestamptz
}

model Contact {
  id          String @id @default(cuid())
  clinicId    String
  waId        String                          // 852XXXXXXXX
  profileName String?
  labels      String[]
  @@unique([clinicId, waId])                  // 同一病人喺兩間店 = 兩條 Contact（隔離）
}

model Conversation {
  id               String     @id @default(cuid())
  clinicId         String
  contactId        String
  status           ConvStatus @default(OPEN)
  assigneeId       String?
  // ★ Realtime P0 (R5, cwi-rt-20260823-a1)：manual assign 樂觀鎖版本號。
  // 人手 assign/takeover 必帶 client 端 version → updateMany({where:{id, assignVersion:v}}) 命中先 +1；
  // 兩 staff 併發 → 後到者 count=0 → 409 ASSIGN_CONFLICT（UI 提示「啱啱俾 {name} 接咗手」+ refetch）。
  // AUTO_CLAIM / SYSTEM 路徑唔帶 version（保留 assigneeId 舊 lock 語義）。
  assignVersion    Int        @default(0)
  // ★ H1：最近一次 assign/transfer/unassign 時間（Send Lock 轉交追蹤；null = 從未派過）
  assignedAt       DateTime? @db.Timestamptz
  intent           String?                    // 最近一次分類結果
  intentConfidence Float?
  // Phase 2（AI triage）：
  // - urgency/aiSummary 同 intent 一齊落 Conversation（唔係 Message）：
  //   UI 隊列欄/側欄要喺對話層顯示，且語義係「呢個對話而家嘅狀態」，
  //   跟緊 Phase 1 已建嘅 intent 欄慣例，避免加新表多一層 join。
  // - urgent 鐵律旗：urgency=HIGH 或 intent=URGENT_PAIN 時由 AI worker 置 true；
  //   對話轉 RESOLVED 或 staff 手動清；置 true 後唔會自動清（避免新訊息蓋過未處理急症）。
  urgency          String?                    // LOW / MED / HIGH（最近一次分類）
  urgent           Boolean  @default(false)
  aiSummary        String?                    // ≤50 字摘要（側欄顯示；語言跟病人）
  // ★ booking-ui（2026-08-23, cwi-bkui-20260823-a1）：patient-context 釘住舊客（lookup match 後落 DB）
  pinnedPatientApricotId String?               // Apricot 病人 id（proxy 落單 patient.patientApricotId 來源）
  pinnedPatientName      String?               // 快照顯示（唔 join；PII 白名單 v2：姓名許可）
  pinnedPhoneHash        String?               // 64-hex HMAC-SHA256（raw phone 永遠唔入 DB）
  // ★ booking-ui（E）：改期 Flow 進行中標記（nfm_reply 見到此欄 → 走 reschedule 變體而非新建 BookingRequest）
  reschedulingApptId     String?               // 目標 Apricot appointment id（null = 無改期進行中）
  lastInboundAt    DateTime? @db.Timestamptz                  // ★ 24h 窗口由呢個欄計
  lastMessageAt    DateTime @db.Timestamptz
  unreadCount      Int        @default(0)

  @@unique([clinicId, contactId])
  @@index([clinicId, status, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  // Phase 1 改動：waMessageId 由 NOT NULL 變 nullable。
  // 原因：outbound 發送鏈係「先寫 Message(OUT,API,QUEUED) 先入 queue」，
  // Graph API 回傳 wamid 之後先 UPDATE 入呢欄（MD §6.3）。NOT NULL 會令
  // QUEUED row 寫唔到。Postgres unique index 允許多 NULL，冪等語義唔變
  // （inbound/status 永遠有 wamid，webhook 冪等仍然成立）。
  waMessageId    String?   @unique            // ★ 冪等 key（webhook 會重發）
  // ★ Realtime P0 (R1, cwi-rt-20260823-a1)：client 端冪等 key（clientMessageId）。
  // composer 每次「新發送意圖」生成一個 UUID；網絡 retry / 雙擊重發用同一個 key。
  // send route 命中已存在 row → 直接回舊 Message（200 冪等）唔再入 queue。
  // 只 OUT/API 訊息有用；inbound/echo 永遠 null（Postgres unique 允許多 NULL）。
  clientMessageId String?   @unique
  direction      Direction
  channel        Channel
  type           String                       // text/image/audio/document/interactive/nfm_reply...
  body           String?                      // 文字內容（at-rest 加密 = 部署層 LUKS/雲碟加密，見 deploy 文件；log 絕不出現）
  // ★ H1：內部備註 @ 咗邊啲 staffId（只 channel=INTERNAL 先有意義；UI autocomplete 入）
  mentions       String[]  @default([])
  mediaPath      String?                      // 落地 /srv/wa-media/<id>，唔存 Meta URL（會過期）
  // ★ Realtime P0 (R4, cwi-rt-20260823-a1)：media 下載狀態（見 MediaStatus enum 註釋）
  mediaStatus    MediaStatus @default(READY)
  status         MsgStatus
  errorCode      String?
  sentByStaffId  String?
  aiDraftId      String?
  // Phase 2b：AI 自動發送標記（AUTO 模式）。設計決策：唔加獨立 `source` enum —
  // 現有 channel(API/APP_ECHO/HISTORY) + sentByStaffId(null) + aiDraftId 已足夠
  // 識別「系統 AI 自動發」；再加 source 會同 channel 雙重事實來源（drift 風險）。
  // AUTO 訊息 = direction=OUT + channel=API + sentByStaffId=null + aiAutoSent=true。
  aiAutoSent     Boolean  @default(false)
  // ★ AI Workflow Phase C（cwi-sess-20260824-c1）：呢條 OUT 訊息屬邊個 slot-filling session
  //   （追溯 session 回覆用；null = 非 session 訊息。無 FK — session 行清唔會阻訊息 retention）。
  bookingSessionId String?
  // ★ Phase B（cwi-tmpl-20260824-b1）：template 發送元數據（type="template" 先有）。
  // 結構：{ name, language, components }（components = [{type:"body",parameters:[...]}]）。
  // ★ PII：只有 template 名/語言/日期時間醫生診所變數 — 零病人自由文本。
  // body 欄 = 預覽文字（UI 顯示；同 template 實際渲染一致）。
  templateMeta   Json?
  waTimestamp    DateTime @db.Timestamptz
  createdAt      DateTime @db.Timestamptz  @default(now())
  @@index([conversationId, waTimestamp])
}

// ★ H2：內部備註已讀回執（確認 ② — tick 顯示 @人 已讀）。
// 前端 IntersectionObserver 入 viewport → POST /api/notes/[id]/read upsert（冪等）。
model NoteReadReceipt {
  id        String   @id @default(cuid())
  messageId String                                  // channel=INTERNAL 嘅 Message
  staffId   String
  readAt    DateTime @db.Timestamptz @default(now())
  @@unique([messageId, staffId])
}

// ★ AI Workflow Phase C（cwi-sess-20260824-c1）：逐店逐類自動化級別（總綱 §3.3 D-4/D-5）。
// category = intent 名（"BOOKING_REQUEST" 等）或 "*"（該店預設）。
// 優先序：exact → "*" → legacy clinic.aiMode（DRAFT→L1, AUTO→L2）；天花板 = env AI_GLOBAL_MAX_LEVEL。
// 寫入只經 admin route（Phase E 先開 UI；C 期 seed/SQL 手動設測試店）。
model AutomationPolicy {
  id        String   @id @default(cuid())
  clinicId  String
  category  String                       // intent；"*" = 該店預設
  level     String                       // L1 / L2 / L3 / L4
  updatedBy String?
  updatedAt DateTime @db.Timestamptz @updatedAt
  @@unique([clinicId, category])
}

// ★ AI Workflow Phase C（cwi-sess-20260824-c1）：slot-filling 對話 session（總綱 §6.3 D-2）。
// slots = SessionSlots（Json — providerApricotId/providerName/date/time/timeOfDay；engine 驗證過先算數）。
// 零病人自由文本落庫：只 business metadata（醫生 id/名、日期、時間、時段偏好）。
model BookingSession {
  id             String               @id @default(cuid())
  conversationId String
  clinicId       String
  status         BookingSessionStatus @default(ACTIVE)
  slots          Json                 // SessionSlots（見 src/lib/ai/session-types.ts）
  turns          Int                  @default(0)
  noProgress     Int                  @default(0)
  createdAt      DateTime @db.Timestamptz @default(now())
  updatedAt      DateTime @db.Timestamptz @updatedAt
  expiresAt      DateTime @db.Timestamptz
  @@index([conversationId, status])
  @@index([status, expiresAt])
}

model AiDraft {
  id                 String      @id @default(cuid())
  conversationId     String
  inReplyToMessageId String
  draftText          String
  model              String
  latencyMs          Int
  status             DraftStatus @default(PROPOSED)
  finalText          String?                  // 員工改完實際發出嘅版本 → 攞嚟計採用率+做微調數據
  createdAt          DateTime @db.Timestamptz    @default(now())
  // Phase 2 冪等：同一條 inbound Message 只可有一條 draft。
  // AI job 重試（attempts 3）或部分失敗重跑時，唯一約束 + findUnique 前置檢查
  // 保證唔會生成重複 draft。一條訊息只觸發一次 AI 分類，語義上多 draft 無意義。
  @@unique([conversationId, inReplyToMessageId])
}

// Phase 2：AI call 統計（singleton row id=1）— admin AI 狀態卡「最近 call 成功率」數據源。
// 由 AI worker 每次 call 後 atomic upsert；web process（admin 頁/API）讀。
// 唔存任何 prompt/response 內容 — 只係計數 + 時間 + 錯訊短句（metadata only）。
model AiCallStats {
  id         Int       @id @default(1)
  totalCalls Int       @default(0)
  okCalls    Int       @default(0)
  lastOkAt   DateTime? @db.Timestamptz
  lastError  String?
  // Phase 2b：最近一次成功 call 嘅 latency/tokens（admin AI 狀態卡實測數據；metadata only）
  lastLatencyMs Int?
  lastTokens    Int?
  updatedAt  DateTime  @db.Timestamptz @default(now()) @updatedAt
}

model BookingRequest {
  id                String        @id @default(cuid())
  conversationId    String
  clinicId          String
  flowToken         String        @unique     // 發 Flow 時生成，nfm_reply 對返
  providerApricotId String
  providerName      String                    // 快照，唔 join
  requestedDate     String                    // YYYY-MM-DD（HK 日界）
  requestedTime     String?                   // HH:mm（pure requirement 變體 = null，改 timeOfDay）
  precheckPassed    Boolean?                  // 發卡嗰刻對照空檔 cache 嘅結果；null = 未經核對（資料源離線，pure requirement 變體）
  timeOfDay         String?                   // MORNING / AFTERNOON / EVENING（pure requirement 變體嘅時段偏好；正常預約 = null）
  status            BookingStatus @default(PENDING)
  handledByStaffId  String?
  handledAt         DateTime? @db.Timestamptz
  // ★ booking-ui（2026-08-23, cwi-bkui-20260823-a1）：代落單（CONFIRMED 態 + rollback + 審計）
  apricotApptId     String?                    // Apricot 單號（workforce create 後寫入；rollback 後清 null）
  // ★ Phase B（cwi-tmpl-20260824-b1）：T-24h 提醒已發時間（冪等旗 — null = 未提醒）。
  // 改期/rollback 時 reset null（新時間/重新確認會再提醒）。
  remindedAt        DateTime? @db.Timestamptz  // Phase B 建表 drift（migration 建 TIMESTAMP(3)）— pre-existing，Phase D 唔經手
  visitReasonCode   String?                    // 卡上揀咗嘅 visit reason（dictionaries code；審計 + remarks 組裝）
  chiefComplaint    String?                    // 主訴快照（Flow 完成時由 conversation.aiSummary 摘；≤50 字）
  // ★ AI Workflow Phase C（cwi-sess-20260824-c1）：L4 AI 自動落單標記（Phase E rollback 統計鈎）。
  //   staff 三掣 / 普通 Flow 路徑 = false；BookingSession AUTO_BOOK 成功 = true。
  autoBooked        Boolean @default(false)
  createdAt         DateTime @db.Timestamptz      @default(now())
  // Phase 3：/bookings 隊列查詢（本店 + 狀態 + 時間）
  @@index([clinicId, status, createdAt])
}

// Phase 3：醫生名錄（sync 表）— SCREEN_PROVIDER 嘅數據源。
// 名錄由 seed（由 greetingConfig.doctors 派生決定性 apricotId）或 admin 手動維護。
// （2026-08-23 workforce 切換：舊 Apricot 醫生 sync 已拆 — workforce API 只提供空檔，無名錄 endpoint。）
// ★ PII：只存醫生名 + Apricot ext id — 零病人資料。
model Provider {
  id        String   @id @default(cuid())
  name      String                    // 醫生名（顯示用）
  apricotId String?  @unique          // Apricot practitioner ext id（mock = mock-pract-<clinic>-<n>）
  active    Boolean  @default(true)
  createdAt DateTime @db.Timestamptz @default(now())
  clinics   ProviderClinic[]
}

model ProviderClinic {
  providerId String
  clinicId   String
  createdAt  DateTime @db.Timestamptz @default(now())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  @@id([providerId, clinicId])
}

// Phase 3：發出咗嘅 WhatsApp Flow 狀態（📅 掣冪等 / 48h 棄單 / nfm_reply 對 token 用）。
// status: SENT（流緊）/ COMPLETED（病人撳 Complete）/ FAILED（precheck 失敗，已重出）/ ABANDONED（48h 棄單）
// ★ 只存 token + 關聯 id — 零病人選擇內容（選擇喺 BookingRequest）。
model FlowSession {
  id               String    @id @default(cuid())
  conversationId   String
  clinicId         String
  flowToken        String    @unique        // 簽咗 conversationId+clinicId 嘅 JWT
  flowMessageWamid String?                   // 發出嘅 interactive flow 訊息 wamid（metadata）
  status           String    @default("SENT")
  createdAt        DateTime  @db.Timestamptz @default(now())
  completedAt      DateTime? @db.Timestamptz
  @@index([conversationId, status])
  @@index([status, createdAt])
}

model AvailabilitySlot {                       // workforce API 嘅 L2 cache（switch 後來源 = clinic-workforce /api/external/v1/availability）
                                               // ★ 只存時段佔用，零病人資料（contract zod schema 已 strip 唔識欄位）
  id                String   @id @default(cuid())
  clinicId          String
  providerApricotId String
  date              String
  startTime         String
  endTime           String
  bookedCount       Int
  isOpen            Boolean                    // workforce response slot.isOpen
  syncedAt          DateTime @db.Timestamptz   // 用 response 嘅 syncedAt（source 新鮮度）
  @@unique([clinicId, providerApricotId, date, startTime])
}

// workforce API 逐店 sync 狀態（switch 後取代 ApricotSession heartbeat — metadata only，零憑證）
// lastOkAt = 最近一次 fetchAvailability 成功（response 過 zod）→ L2 新鮮度判斷（≤5 分鐘）
// + 5 分鐘健康自檢嘅 workforce_api_degraded 訊號（持續 >15 分鐘 → alert）
model WorkforceSyncState {
  clinicId      String    @id
  lastOkAt      DateTime  @db.Timestamptz
  lastStale     Boolean?  // 最近一次成功 response 嘅 stale 旗（workforce 對上游過咗 30 分鐘）
  lastErrorAt   DateTime? @db.Timestamptz
  lastErrorCode String?   // metadata 短碼（http_500 / timeout / zod_invalid / clinic_not_found ...）
  updatedAt     DateTime  @db.Timestamptz @updatedAt
}

model WebhookEvent {                           // 冪等 + 除錯（★ 唔存 payload 原文，只存 metadata）
  id          String   @id                     // wamid / event id
  field       String
  receivedAt  DateTime @db.Timestamptz @default(now())
  processedAt DateTime? @db.Timestamptz
}

model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?                              // AI 自動發送 = null（無 staff 參與）
  action    String                             // SEND / AI_AUTO_SEND / CONFIRM_BOOKING / LOGIN / EXPORT ...
  entity    String?
  entityId  String?
  // Phase 2b：附加 metadata（metadata only — 永不存訊息原文 PII）。
  // AI_AUTO_SEND 用：{ conversationId, draftId, intent, urgency }
  meta      Json?
  createdAt DateTime @db.Timestamptz @default(now())
}

// Phase 4：健康自檢 / 監控警報（MD §9.3）。
// - 由 cron `health-check`（5 分鐘）/ `quality-check`（每日）產生；異常行 + 通知（ALERT_CHANNEL）。
// - 冪等：同 (type, clinicId) 未解決（resolvedAt IS NULL）只可有一條 —
//   cron 每 5 分鐘重跑唔會重覆彈警報；狀況恢復後由下一次 check 自動 set resolvedAt。
// - ★ detail 只准 metadata（queue 名/計數/分鐘數/rating/disk %）— 永不存訊息原文（iron rule 1）。
// - clinicId：per-clinic 警報（webhook_stale / quality_rating）帶店；系統級（queue_depth /
//   ai_breaker_open / apricot_sync_stale / disk_low）= null。
model Alert {
  id         String    @id @default(cuid())
  type       String    // webhook_stale | queue_depth | ai_breaker_open | apricot_sync_stale | disk_low | quality_rating
  severity   String    // MEDIUM | HIGH
  clinicId   String?
  clinicCode String?   // 快照（顯示用；唔 join — 店被刪都睇到）
  detail     Json?     // metadata only
  createdAt  DateTime  @db.Timestamptz @default(now())
  resolvedAt DateTime? @db.Timestamptz
  @@index([type, clinicId, resolvedAt])
  @@index([resolvedAt, createdAt])
}

// Phase 4：週一自動營運報表（MD §9.3：訊息量/店、FRT 中位數、草稿採用率、Flow 完成率、
// 預約卡→確認轉化率 + 中位處理時間）。
// - 每星期一 07:00 cron 對「上一週（Mon 00:00 → Sun 24:00，本地時區）」生成。
// - 一行一個 scope：clinicId=null = ALL（ADMIN 視角，metrics 內含逐店 breakdown）；
//   clinicId=店 = 該店（STAFF /admin/ops 視角）。
// - metrics/text 全部係計數/中位數/比率（metadata only）— 零病人資料。
// ★ AI Workflow Phase A（cwi-ai-20260824-t1）：內部通知軌（D-8/D-9）。
// 同客戶訊息 unread 完全分開（唔影響 Conversation.unreadCount）。
// title = 顯示句（scrub 後；永不含病人訊息原文）；meta = metadata only（wamid/bookingId 等）。
// 已讀 = readAt 有值（per-staff：一個職員標已讀只改自己嗰個視角？— v1 語義：readAt 有值 = 已讀，
// 任何職員標即算已讀（同 Alert 水位；v2 先做 per-staff 視角））。
model StaffNotice {
  id             String     @id @default(cuid())
  clinicId       String
  conversationId String?
  kind           NoticeKind
  title          String
  meta           Json?
  createdAt      DateTime       @db.Timestamptz @default(now())
  readByStaffId  String?
  readAt         DateTime?      @db.Timestamptz
  @@index([clinicId, readAt, createdAt])
}

// ★ AI Workflow D-10（cwi-ai-20260824-t1）：病人事實抽取表。
// 鐵律三條：
// (1) 來源只可以係 Message（sourceMessageId 必填 — 可追溯；Apricot 資料永不入呢張表）；
// (2) retention 跟對話 24 個月 — retention-purge cron 一齊剷（連同對應 Message 刪除）；
// (3) v1 只做 deterministic 抽取（Phase C：completed BookingSession 嘅 preferred provider/timeOfDay
//     自動落 PREFERENCE）— LLM 自由抽 facts 排 Phase E 後（prompt 唔加職責，避免影響分類質素）。
// 無 FK relation（純 String 欄）— 由 purge cron 負責級聯清理（delete-by-sourceMessageId）。
model PatientFact {
  id              String   @id @default(cuid())
  contactId       String
  clinicId        String
  kind            String   // PREFERENCE / LOGISTICS / SELF_REPORTED
  text            String   // ≤100 字，scrub 後先落庫
  sourceMessageId String   // 必填 — 邊條訊息講嘅（可追溯）
  sourceWamid     String?
  model           String?  // 抽取者（deterministic 抽 = null）
  createdAt       DateTime @db.Timestamptz @default(now())
  @@index([contactId, createdAt])
}

// ★ AI Workflow Phase D（cwi-ai-20260825-t4）：workflow 參數化 + builder v1（總綱 §6.4 D-11）。
// 可調嘢（文案／閾值／開關）收歸呢張版本化表：admin 改 → publish → 生效 → 可回退，全程 audit。
// - clinicId null = 全局；店行有自己 ACTIVE 就 override（getParams 三級 fallback）。
// - status 用 String 唔用 enum（同 Alert.severity 慣例 — 慳一個 CREATE TYPE，零鎖表）。
// - graph = 唯讀顯示用 nodes/edges（由內建模板 buildGraph 生成）；params 先係實際生效參數。
// - v1 執行器唔係 graph interpreter — 執行仍係現有 code path，每決策點讀 ACTIVE params。
model WorkflowDefinition {
  id          String    @id @default(cuid())
  clinicId    String?                        // null = 全局；店行有自己 ACTIVE 就 override
  key         String                         // "triage" | "booking-session" | "reminder"
  version     Int
  status      String                         // DRAFT / ACTIVE / ARCHIVED
  graph       Json                           // { nodes, edges }（顯示用，由內建模板生成）
  params      Json                           // 實際生效參數（見 src/lib/workflow/definitions.ts 每 key schema）
  createdBy   String?
  publishedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @db.Timestamptz @default(now())
  @@unique([clinicId, key, version])
  @@index([key, status])
}

model OpsReport {
  id          String   @id @default(cuid())
  periodStart DateTime @db.Timestamptz   // 週一 00:00（本地）
  periodEnd   DateTime @db.Timestamptz   // 下週一 00:00（exclusive）
  clinicId    String   @default("")      // "" = ALL（全部店；Postgres unique 對 NULL 唔生效 → 用 "" sentinel）
  metrics     Json
  text        String                     // 人類可讀報表（俾 ALERT_CHANNEL 推送；metadata only）
  createdAt   DateTime @db.Timestamptz @default(now())
  @@unique([periodStart, clinicId])
  @@index([periodStart])
}
